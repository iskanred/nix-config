{
  username = "user";
  homeDirectory = "/Users/user"; # Use /home/user on Linux.
  system = "aarch64-darwin"; # Or x86_64-linux, aarch64-linux, x86_64-darwin.

  # Must point to this private checkout so dr/hm rebuild the work configuration.
  configDirectory = "/Users/user/.config/nix-config-work";
}
